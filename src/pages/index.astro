---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Harsh Shinde | Developer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="font-['Poppins'] bg-white text-black antialiased">
    
    <Navbar />

    <main class="max-w-6xl mx-auto px-6">
      
      <section id="profile" class="min-h-[calc(100vh-6rem)] flex flex-col md:flex-row justify-center items-center gap-12 py-12 md:py-0">
        
        <div class="w-64 h-64 md:w-[380px] md:h-[380px] rounded-full overflow-hidden shadow-md">
          <img 
            src="/assets/profile.jpg" 
            alt="Harshvardhan Shinde" 
            class="w-full h-full object-cover"
          />
        </div>
        
        <div class="text-center md:text-left self-center">
          <p class="font-semibold text-zinc-500 tracking-wide text-sm md:text-base">Hello, I'm</p>
          <h1 class="text-4xl md:text-5xl font-bold my-2 text-zinc-900">Harshvardhan Shinde</h1>
          <p class="text-xl md:text-2xl text-zinc-600 mb-6 font-medium">Software Developer</p>
          
          <div class="flex justify-center md:justify-start gap-4">
            <a 
              href="/assets/HarshvardhanShinde_New_Main.pdf" 
              target="_blank" 
              class="font-semibold px-6 py-3 min-w-[140px] text-center border border-zinc-700 text-zinc-800 rounded-full hover:bg-zinc-800 hover:text-white transition-all duration-300 shadow-sm"
            >
              Download CV
            </a>
            <a 
              href="#contact" 
              class="font-semibold px-6 py-3 min-w-[140px] text-center border border-zinc-800 bg-zinc-800 text-white rounded-full hover:bg-black hover:border-black transition-all duration-300 shadow-sm"
            >
              Contact Info
            </a>
          </div>
          
          <div class="flex justify-center md:justify-start gap-5 mt-8">
            <a href="https://www.linkedin.com/in/harshvardhan-shinde-b0a0a1295/" target="_blank" rel="noopener noreferrer">
              <img src="/assets/linkedin.png" alt="LinkedIn" class="h-7 w-7 opacity-80 hover:opacity-100 hover:scale-110 transition-all duration-200" />
            </a>
            <a href="https://github.com/H-Shinde" target="_blank" rel="noopener noreferrer">
              <img src="/assets/github.png" alt="GitHub" class="h-7 w-7 opacity-80 hover:opacity-100 hover:scale-110 transition-all duration-200" />
            </a>
          </div>
        </div>

      </section>
<section id="about" class="min-h-[80vh] pt-20 pb-12 flex flex-col justify-center">
        <p class="text-center text-sm text-zinc-400 tracking-widest uppercase font-medium mb-1">Get To Know More</p>
        <h1 class="text-4xl font-bold text-center mb-12 text-zinc-900">About Me</h1>
        
        <div class="flex flex-col lg:flex-row gap-12 items-center justify-center">
          
          <div class="w-64 h-64 md:w-[300px] md:h-[300px] shrink-0">
            <img 
              src="/assets/about-pic.png" 
              alt="About Profile" 
              class="rounded-3xl w-full h-full object-cover shadow-sm border border-zinc-100" 
            />
          </div>
          
          <div class="flex-1 w-full max-w-2xl">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
              
              <div class="p-6 bg-white rounded-3xl border border-zinc-200 text-center shadow-sm hover:border-zinc-300 transition-colors duration-200">
                <img src="/assets/experience.png" alt="Experience icon" class="h-7 mx-auto mb-3" />
                <h3 class="font-bold text-zinc-800 text-lg mb-1">Experience</h3>
                <p class="text-sm text-zinc-500 leading-relaxed">
                  Research Intern<br />
                  CSE-305 Teaching Assistant<br />
                  Peer Mentor
                </p>
              </div>
              
              <div class="p-6 bg-white rounded-3xl border border-zinc-200 text-center shadow-sm hover:border-zinc-300 transition-colors duration-200">
                <img src="/assets/education.png" alt="Education icon" class="h-7 mx-auto mb-3" />
                <h3 class="font-bold text-zinc-800 text-lg mb-1">Education: UB</h3>
                <p class="text-sm text-zinc-500 leading-relaxed">
                  B.S/M.S in Computer Science<br />
                  Minor in Mathematics
                </p>
              </div>
              
            </div>
            
            <div class="text-zinc-600 text-base leading-relaxed text-justify bg-zinc-50/50 p-6 rounded-3xl border border-zinc-100">
              <p>
                I'm a developer and CS Graduate student at UB passionate about building high-performance software. 
                With a strong foundation in mathematics and hands-on experience ranging from deep learning and database internals to modern frontend development, 
                I thrive on tackling complex technical challenges across the entire stack. When I'm not writing code or analyzing data, you can usually find me studying Japanese or staying active at the gym.
              </p>
            </div>
          </div>
          
        </div>
      </section>
    </main>

  </body>
</html>