---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';

// Your project data array — feel free to modify the text or add more projects here
const projects = [
  {
    title: "Taco-DB Engine",
    description: "An embedded storage engine featuring a B+ Tree index layout, custom page management, and Volcano-style iterator execution.",
    tech: ["C++", "Storage Engines", "Database Systems"],
    link: "#"
  },
  {
    title: "Distributed MapReduce Framework",
    description: "A fault-tolerant distributed data processing library implementing Master/Worker coordinating tasks over RPC.",
    tech: ["Go", "Distributed Systems", "gRPC"],
    link: "#"
  },
  {
    title: "Autonomous Vehicle Model Distillation",
    description: "Distilling large behavioral prediction models into lightweight inference models targeted for real-time edge hardware.",
    tech: ["PyTorch", "Model Compression", "Computer Vision"],
    link: "#"
  }
];
---

<Layout title="Harshvardhan Shinde | Software Engineer">
  <main class="space-y-20">
    
    <section class="space-y-4">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-50">
        Hi, I'm <span class="text-emerald-400">Harshvardhan Shinde</span>.
      </h1>
      <p class="text-lg text-zinc-400 leading-relaxed max-w-2xl">
        I build high-performance backend systems, distributed architectures, and developer tooling. Currently focused on systems programming, database internals, and machine learning infrastructure.
      </p>
      <div class="flex gap-4 text-sm text-zinc-500 font-medium pt-2">
        <a href="https://github.com" target="_blank" class="hover:text-zinc-200 transition-colors">GitHub</a>
        <span>·</span>
        <a href="https://linkedin.com" target="_blank" class="hover:text-zinc-200 transition-colors">LinkedIn</a>
        <span>·</span>
        <a href="mailto:your.email@example.com" class="hover:text-zinc-200 transition-colors">Email</a>
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-xl font-semibold tracking-tight text-zinc-200">Selected Work</h2>
      
      <div class="grid gap-6">
        {projects.map((project) => (
          <a 
            href={project.link}
            class="group block p-6 bg-zinc-900/40 border border-zinc-800/50 rounded-xl hover:border-zinc-700/80 hover:bg-zinc-900/80 transition-all duration-200"
          >
            <div class="flex justify-between items-start gap-4">
              <h3 class="font-medium text-zinc-100 group-hover:text-emerald-400 transition-colors">
                {project.title}
              </h3>
              <span class="text-zinc-600 group-hover:text-zinc-400 transition-transform duration-200 group-hover:translate-x-1 group-hover:-translate-y-1 text-sm">
                ↗
              </span>
            </div>
            <p class="mt-2 text-sm text-zinc-400 leading-relaxed">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mt-4">
              {project.tech.map((techItem) => (
                <span class="text-xs px-2.5 py-1 bg-zinc-800/40 text-zinc-400 rounded-md border border-zinc-800/60">
                  {techItem}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <div class="space-y-1">
        <h2 class="text-xl font-semibold tracking-tight text-zinc-200">Get in Touch</h2>
        <p class="text-sm text-zinc-400">Have an interesting technical problem or opportunity? Drop a line.</p>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4 max-w-md">
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE">
        
        <div>
          <input 
            type="email" 
            name="email" 
            required 
            placeholder="your.email@example.com" 
            class="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20 transition-all"
          />
        </div>
        <div>
          <textarea 
            name="message" 
            required 
            rows="4" 
            placeholder="Your message..." 
            class="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-800 rounded-lg text-sm text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-emerald-500/50 focus:ring-1 focus:ring-emerald-500/20 transition-all"
          ></textarea>
        </div>
        <button 
          type="submit" 
          class="px-4 py-2 bg-zinc-100 hover:bg-zinc-200 text-zinc-950 font-medium text-sm rounded-lg transition-colors shadow-sm"
        >
          Send Message
        </button>
      </form>
    </section>

  </main>
</Layout>