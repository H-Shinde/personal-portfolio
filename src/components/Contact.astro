---
// src/components/Contact.astro
const contactLinks = [
  {
    label: "Email",
    value: "Hdshinde202@gmail.com",
    href: "mailto:Hdshinde202@gmail.com",
    icon: "email",
  },
  {
    label: "GitHub",
    value: "H-Shinde",
    href: "https://github.com/H-Shinde",
    icon: "github",
  },
  {
    label: "LinkedIn",
    value: "Harshvardhan Shinde",
    href: "https://www.linkedin.com/in/harshvardhan-shinde-b0a0a1295/",
    icon: "linkedin",
  },
];
---

<section id="contact" class="min-h-[80vh] pt-20 pb-12 flex flex-col justify-center">
  <p class="text-center text-sm text-zinc-400 tracking-widest uppercase font-medium mb-1">Get In Touch</p>
  <h1 class="text-4xl font-bold text-center mb-12 text-zinc-900 dark:text-white">Contact</h1>

  <div class="flex flex-col lg:flex-row gap-8 items-start justify-center max-w-5xl mx-auto w-full px-6">

    <!-- Contact info cards -->
    <div class="w-full lg:w-[280px] shrink-0 flex flex-col gap-4">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          target={link.icon === "email" ? "_self" : "_blank"}
          class="flex items-center gap-4 p-4 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-sm hover:border-zinc-400 dark:hover:border-zinc-600 hover:scale-[1.02] transition-all duration-300 group"
        >
          <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0 text-zinc-700 dark:text-zinc-300 group-hover:bg-zinc-800 group-hover:text-white dark:group-hover:bg-zinc-200 dark:group-hover:text-zinc-900 transition-all duration-300">
            {link.icon === "email" && (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
            {link.icon === "github" && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.303-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
            )}
            {link.icon === "linkedin" && (
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            )}
          </div>
          <div>
            <p class="text-xs text-zinc-400 dark:text-zinc-500 font-medium">{link.label}</p>
            <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-100">{link.value}</p>
          </div>
        </a>
      ))}
    </div>

    <!-- Contact form -->
    <div class="flex-1 w-full p-6 sm:p-8 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
      <form
        id="contact-form"
        action="https://formspree.io/f/YOUR_FORM_ID"
        method="POST"
        class="flex flex-col gap-4"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1.5">
            <label for="name" class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">Name</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition-all"
              placeholder="Your name"
            />
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="email" class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition-all"
              placeholder="you@example.com"
            />
          </div>
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 uppercase tracking-wide">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="5"
            class="px-4 py-3 rounded-2xl bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-800 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-zinc-400 dark:focus:ring-zinc-600 transition-all resize-none"
            placeholder="What's on your mind?"
          ></textarea>
        </div>

        <button
          type="submit"
          id="contact-submit"
          class="mt-2 font-semibold text-sm px-6 py-3 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-full hover:bg-zinc-700 dark:hover:bg-zinc-200 transition-all duration-300 shadow-sm cursor-pointer"
        >
          Send Message
        </button>

        <p id="contact-status" class="text-sm text-center hidden"></p>
      </form>
    </div>

  </div>
</section>

<script is:inline>
  function setupContactForm() {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    const submitBtn = document.getElementById('contact-submit');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
        });

        if (response.ok) {
          status.textContent = "Thanks! Your message has been sent.";
          status.classList.remove('hidden', 'text-red-500');
          status.classList.add('text-green-600', 'dark:text-green-400');
          form.reset();
        } else {
          throw new Error('Form submission failed');
        }
      } catch (err) {
        status.textContent = "Something went wrong. Please try again or email me directly.";
        status.classList.remove('hidden', 'text-green-600', 'dark:text-green-400');
        status.classList.add('text-red-500');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Message';
      }
    });
  }

  setupContactForm();
  document.addEventListener('DOMContentLoaded', setupContactForm);
</script>