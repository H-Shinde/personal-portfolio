---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md border-b border-gray-100 dark:border-zinc-900 transition-colors duration-300">
  <nav class="max-w-6xl mx-auto px-6 h-24 flex justify-between items-center">
    <div class="text-2xl font-normal tracking-wide text-black dark:text-white">
      Harshvardhan Shinde
    </div>
    
    <div class="flex items-center gap-6">
      <ul class="flex gap-8 text-lg font-medium">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class="text-zinc-700 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- THE THEME TOGGLE BUTTON -->
      <button 
        id="theme-toggle" 
        class="p-2 rounded-full border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-100 dark:hover:bg-zinc-900 text-zinc-700 dark:text-zinc-300 transition-all cursor-pointer z-50 block" 
        aria-label="Toggle dark mode"
      >
        <!-- Sun Icon (Hidden in Light, Visible in Dark) -->
        <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <!-- Moon Icon (Visible in Light, Hidden in Dark) -->
        <svg class="w-5 h-5 block dark:hidden text-zinc-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  function initThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    
    if (themeToggle) {
      // Remove any old event listeners just in case Astro re-renders
      themeToggle.removeEventListener('click', handleToggle);
      themeToggle.addEventListener('click', handleToggle);
    }
  }

  function handleToggle() {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  // Run immediately on file load
  initThemeToggle();

  // Fallback for Astro lifecycle / delay loads
  document.addEventListener('DOMContentLoaded', initThemeToggle);
</script>