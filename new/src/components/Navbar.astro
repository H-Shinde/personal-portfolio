---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
  <nav class="max-w-6xl mx-auto px-6 h-24 flex justify-between items-center">
    <div class="text-2xl font-normal tracking-wide text-black">
      Harshvardhan Shinde
    </div>
    
    <ul class="hidden md:flex gap-8 text-lg font-medium">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-zinc-700 hover:text-black transition-all duration-300 hover:underline hover:underline-offset-[16px] hover:decoration-zinc-400">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button id="menu-btn" class="block md:hidden focus:outline-none z-50 relative w-6 h-5 flex flex-col justify-between">
      <span class="w-full h-0.5 bg-black transition-all duration-300 origin-top-left"></span>
      <span class="w-full h-0.5 bg-black transition-all duration-300"></span>
      <span class="w-full h-0.5 bg-black transition-all duration-300 origin-bottom-left"></span>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden fixed inset-0 bg-white z-40 flex flex-col items-center justify-center gap-8 text-xl font-medium transition-all duration-300">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-link text-zinc-800 hover:text-black transition-colors">
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    mobileMenu?.classList.toggle('hidden');
    mobileMenu?.classList.toggle('flex');
    
    const spans = menuBtn?.querySelectorAll('span');
    if (spans) {
      spans[0].classList.toggle('rotate-45');
      spans[0].classList.toggle('translate-x-1');
      spans[0].classList.toggle('translate-y-0.5');
      spans[1].classList.toggle('opacity-0');
      spans[2].classList.toggle('-rotate-45');
      spans[2].classList.toggle('translate-x-1');
      spans[2].classList.toggle('-translate-y-0.5');
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));
</script>